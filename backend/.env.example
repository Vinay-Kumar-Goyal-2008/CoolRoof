# Copy to backend/.env. Every key is optional: missing keys fall back to local stubs.

# local (default) or aws
RUNTIME=local
CITY=mini_city
LOG_LEVEL=INFO

# Data sources for local runs: fixture (offline) or live
LANDSAT_SOURCE=fixture          # fixture | planetary_computer
NWP_SOURCE=fixture              # fixture | open_meteo
SOLAR_SOURCE=fixture            # fixture | live (PVGIS → NASA POWER)
FIRMS_SOURCE=fixture            # fixture | live

# Agent LLM: Anthropic API locally; without a key a deterministic mock is used
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# BEDROCK_MODEL_ID=           # used when RUNTIME=aws

# TTS: Deepgram (English). Hindi uses Amazon Polly when AWS_REGION is set.
DEEPGRAM_API_KEY=
AWS_REGION=

# NASA FIRMS area API key
FIRMS_MAP_KEY=

# API keys for planner/admin routes (Phase 1; Cognito in Phase 2)
PLANNER_API_KEY=dev-planner-key
ADMIN_API_KEY=dev-admin-key
FRONTEND_ORIGIN=http://localhost:3000

# Scheduled jobs inside the API process (fire poll, daily heat-dome forecast, staleness)
ENABLE_JOBS=false
# Two-person approval for advisories; daily speech-synthesis cap
ADVISORY_TWO_PERSON=false
TTS_DAILY_CAP=200
# Cognito (leave empty to use the local API keys above)
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
