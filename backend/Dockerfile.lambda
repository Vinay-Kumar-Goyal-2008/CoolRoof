# Lambda container for the FastAPI app (rasterio/GDAL wheels exceed the 250 MB zip limit).
FROM public.ecr.aws/lambda/python:3.12
COPY pyproject.toml README.md ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir uv && uv pip install --system --no-cache \
    fastapi mangum pydantic pydantic-settings pyyaml structlog httpx numpy pandas pyarrow \
    shapely pyproj rasterio geopandas scipy boto3 fpdf2 uharfbuzz pymupdf apscheduler \
    strands-agents jsonschema
COPY packages ${LAMBDA_TASK_ROOT}/packages
COPY config ${LAMBDA_TASK_ROOT}/config
COPY rules ${LAMBDA_TASK_ROOT}/rules
COPY seed ${LAMBDA_TASK_ROOT}/seed
COPY assets ${LAMBDA_TASK_ROOT}/assets
COPY tests/fixtures/mini_city ${LAMBDA_TASK_ROOT}/tests/fixtures/mini_city
CMD ["packages.api.app.handler"]
